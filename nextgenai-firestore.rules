rules_version = '2';

// NextGenAI Optional Static Portfolio Admin Mode (Firebase Free Spark Plan)
// Public visitors: read-only access to /site_content/main
// Write access: restricted strictly to your single signed-in admin email.
service cloud.firestore {
  match /databases/{database}/documents {
    function isNextGenAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == "YOUR_ADMIN_EMAIL_HERE";
    }

    match /site_content/{docId} {
      allow read: if docId == "main";
      allow write: if docId == "main" && isNextGenAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
