# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_APP_URL: Public origin used by Firebase Auth email verification & password reset links
# (e.g. https://your-school-domain.netlify.app or http://localhost:3000)
# Leave blank to automatically default to window.location.origin at runtime.
VITE_APP_URL=""

# Firebase Auth Email Setup Notes (Spark Free Plan — no secrets required in frontend):
# 1. Firebase Console -> Authentication -> Sign-in method -> Enable Email/Password.
# 2. Firebase Console -> Authentication -> Settings -> Authorized domains:
#    Add your Netlify domain, custom domain, and localhost.
# 3. Firebase Console -> Authentication -> Templates -> Customize Action URL:
#    Point to your app URL (e.g. https://your-app.netlify.app/) to render the in-app
#    Verification & Password Reset landing view (?mode=verifyEmail / ?mode=resetPassword).
# 4. Optional Custom Sender Domain: Add SPF & DKIM TXT/CNAME DNS records via Firebase Console
#    to send from noreply@yourschool.com instead of noreply@<project-id>.firebaseapp.com.

